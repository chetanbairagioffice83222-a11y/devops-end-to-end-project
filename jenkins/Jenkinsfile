pipeline {
    agent any

    tools {
        nodejs 'node18'
    }

    stages {
        stage('Checkout Code') {
            steps {
                git branch: 'develop',
                    url: ' https://github.com/chetanbairagioffice83222-a11y/devops-end-to-end-project.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'cd app/backend && npm install'
            }
        }

        stage('Run Tests') {
            steps {
                sh 'cd app/backend && npm test || echo "No tests yet"'
            }
        }

        stage('Build') {
            steps {
                sh 'cd app/backend && npm run build || echo "No build step yet"'
            }
        }

        stage('Syntax Check') {
       steps {
        sh 'cd app/backend && node index.js'
    }
}

    }

    post {
        success {
            echo '✅ Build Successful'
        }
        failure {
            echo '❌ Build Failed'
        }
    }
}
