pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        timestamps()
    }

    tools {
        nodejs 'node18'
    }

    environment {
        NODE_ENV = 'development'
    }

    stages {

        stage('Checkout Code') {
            steps {
                git branch: 'develop',
                    url: 'https://github.com/chetanbairagioffice83222-a11y/devops-end-to-end-project.git'
            }
        }

        // All backend steps wrapped in dir to avoid repeated cd
        stage('Backend Build & Test') {
            steps {
                dir('app/backend') {

                    stage('Install Dependencies') {
                        steps {
                            sh 'npm ci'
                        }
                    }

                    stage('Syntax Check') {
                        steps {
                            sh 'node --check index.js'
                        }
                    }

                    stage('Run Tests') {
                        steps {
                            sh 'npm test'
                        }
                    }

                    stage('SonarQube Analysis') {
    steps {
        script {
            def scannerHome = tool 'SonarScanner'
            withSonarQubeEnv('SonarQube') {
                sh "${scannerHome}/bin/sonar-scanner " +
                   "-Dsonar.projectKey=devops-end-to-end " +
                   "-Dsonar.projectName=Sonarqube07 " +
                   "-Dsonar.sources=app/backend " +
                   "-Dsonar.sourceEncoding=UTF-8"
            }
        }
    }
}


                } // end dir
            }
        }

    }

    post {
        success {
            echo '✅ Pipeline Successful'
        }
        failure {
            echo '❌ Pipeline Failed'
        }
    }
}
