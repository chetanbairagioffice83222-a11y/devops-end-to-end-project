pipeline {
    agent any

    tools {
        nodejs 'node18'
    }

    stages {

        stage('Checkout Code') {
            steps {
                git branch: 'develop',
                    url: 'https://github.com/chetanbairagioffice83222-a11y/devops-end-to-end-project.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'cd app/backend && npm install'
            }
        }

        stage('Syntax Check') {
            steps {
                sh 'cd app/backend && node --check index.js'
            }
        }

        stage('Run Tests') {
            steps {
                sh 'cd app/backend && npm test'
            }
        }

    } // end of stages

    post {
        success {
            echo '✅ Pipeline Successful'
        }
        failure {
            echo '❌ Pipeline Failed'
        }
    }

} // end of pipeline
