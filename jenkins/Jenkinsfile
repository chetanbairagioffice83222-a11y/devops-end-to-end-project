pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        timestamps()
    }

    tools {
        nodejs 'node18'
    }

    environment {
        NODE_ENV = 'development'
    }

    stages {

        stage('Checkout Code') {
            steps {
                git branch: 'develop',
                    url: 'https://github.com/chetanbairagioffice83222-a11y/devops-end-to-end-project.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('app/backend') {
                    sh 'npm ci'
                }
            }
        }

        stage('Syntax Check') {
            steps {
                dir('app/backend') {
                    sh 'node --check index.js'
                }
            }
        }

        stage('Run Tests') {
            steps {
                dir('app/backend') {
                    sh 'npm test'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('app/backend') {
                    script {
                        def scannerHome = tool 'SonarScanner'
                        withSonarQubeEnv('SonarQube') {
                            sh "${scannerHome}/bin/sonar-scanner " +
                               "-Dsonar.projectKey=devops-end-to-end " +
                               "-Dsonar.projectName=Sonarqube07 " +
                               "-Dsonar.sources=. " +
                               "-Dsonar.sourceEncoding=UTF-8"
                        }
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                script {
                    // Wait for SonarQube quality gate result and fail the pipeline if it fails
                    timeout(time: 10, unit: 'MINUTES') {
                        waitForQualityGate abortPipeline: true
                    }
                }
            }
        }

    }

    post {
        success {
            echo '✅ Pipeline Successful'
        }
        failure {
            echo '❌ Pipeline Failed'
        }
    }
}
